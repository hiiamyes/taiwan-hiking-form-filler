{
  "manifest_version": 3,
  "name": "Taiwan Hiking Form Filler",
  "version": "0.1.0",
  "description": "Starts a bundled Taiwan hiking application workflow.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://hike.taiwan.gov.tw/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hike.taiwan.gov.tw/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "templates/*.json"
      ],
      "matches": [
        "https://hike.taiwan.gov.tw/*"
      ]
    }
  ]
}
