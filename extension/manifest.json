{
  "manifest_version": 3,
  "name": "Taiwan Hiking Form Filler",
  "version": "0.1.0",
  "description": "Chrome extension version of src/apply.js.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://hike.taiwan.gov.tw/*"
  ],
  "action": {
    "default_title": "Fill Taiwan hiking application",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hike.taiwan.gov.tw/*"
      ],
      "js": [
        "helpers.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
